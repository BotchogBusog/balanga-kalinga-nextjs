# Same database as balanga-kalinga-php
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=balanga_kalinga_php
# Set to true when the provider requires TLS (for example PlanetScale).
DB_SSL=false
# Local default is true; set false on managed databases where CREATE DATABASE is forbidden.
DB_AUTO_CREATE=true

JWT_SECRET=change-me-to-a-long-random-string

# AI (same keys as balanga-kalinga-php/.env) — optional, app falls back to offline replies
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email confirmation after account registration (SMTP)
# Example: smtp.gmail.com with a Google App Password, or your school mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Use a verified sender address, for example: Balanga Kalinga <no-reply@your-domain.edu.ph>
SMTP_FROM=
